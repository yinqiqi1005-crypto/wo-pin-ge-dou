DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECURE_COOKIES=false
DJANGO_HSTS_SECONDS=0
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SERVE_MEDIA=true
DJANGO_MANIFEST_STATIC=false
DJANGO_WHITENOISE=false

# Use sqlite for the smallest local setup. Set DB_ENGINE=postgresql when
# PostgreSQL is available.
DB_ENGINE=sqlite
DB_NAME=wo_pin_ge_dou
DB_USER=wo_pin_ge_dou
DB_PASSWORD=replace-me
DB_HOST=127.0.0.1
DB_PORT=5432

REDIS_URL=redis://127.0.0.1:6379/0
CELERY_TASK_ALWAYS_EAGER=true

# AI providers are configurable. "rules" keeps local development offline.
AI_ANALYSIS_PROVIDER=rules
AI_ANALYSIS_MODEL=gpt-5.6-luna
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
